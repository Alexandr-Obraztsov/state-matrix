{
  "system": "Checkout",
  "source": "examples/checkout-spec.md",
  "params": {
    "cart": {
      "type": "endpoint",
      "desc": "Ответ на запрос корзины",
      "from": "examples/checkout-spec.md:§2",
      "all_values": [
        "pending",
        "ok",
        "ok_empty",
        "error_network",
        "error_server"
      ],
      "values": [
        "pending",
        "ok",
        "ok_empty",
        "error"
      ],
      "grouping": "§2 описывает обе ошибки одинаково",
      "special": [
        "timeout"
      ]
    },
    "amount": {
      "type": "number",
      "desc": "Сумма заказа в копейках",
      "from": "examples/checkout-spec.md:§3",
      "all_values": [
        "zero",
        "typical",
        "over_max"
      ],
      "values": [
        "zero",
        "typical",
        "over_max"
      ],
      "special": [
        "negative"
      ]
    },
    "auth": {
      "type": "enum",
      "desc": "Авторизован ли пользователь",
      "from": "examples/checkout-spec.md:§4",
      "all_values": [
        "guest",
        "user"
      ],
      "values": [
        "guest",
        "user"
      ]
    },
    "promo": {
      "type": "enum",
      "desc": "Состояние промокода",
      "from": "examples/checkout-spec.md:§4",
      "all_values": [
        "absent",
        "valid",
        "expired"
      ],
      "values": [
        "absent",
        "valid",
        "expired"
      ]
    }
  },
  "excluded": {},
  "constraints": [
    {
      "id": "r1",
      "evidence": "examples/checkout-spec.md:§4",
      "desc": "Гость промокод не применяет",
      "forbid": {
        "auth": "guest",
        "promo": [
          "valid",
          "expired"
        ]
      }
    },
    {
      "id": "r2",
      "evidence": "examples/checkout-spec.md:§2",
      "desc": "До загрузки форма не рендерится",
      "when": {
        "cart": [
          "pending",
          "error",
          "ok_empty"
        ]
      },
      "irrelevant": [
        "amount",
        "promo",
        "auth"
      ]
    }
  ],
  "states": [
    {
      "name": "Загрузка",
      "when": {
        "cart": "pending"
      },
      "desc": "Скелетон формы",
      "evidence": "examples/checkout-spec.md:§5"
    },
    {
      "name": "Ошибка сети",
      "when": {
        "cart": "error"
      },
      "desc": "Заглушка с повтором",
      "evidence": "examples/checkout-spec.md:§5"
    },
    {
      "name": "Пустая корзина",
      "when": {
        "cart": "ok_empty"
      },
      "desc": "«Корзина пуста»",
      "evidence": "examples/checkout-spec.md:§5"
    },
    {
      "name": "Бесплатный заказ",
      "when": {
        "cart": "ok",
        "amount": "zero"
      },
      "desc": "Оплата не запрашивается",
      "evidence": "examples/checkout-spec.md:§5"
    },
    {
      "name": "Оформление",
      "when": {
        "cart": "ok"
      },
      "desc": "Форма оплаты",
      "evidence": "examples/checkout-spec.md:§5"
    }
  ]
}
