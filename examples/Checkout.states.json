{
  "system": "Checkout",
  "source": "examples/checkout-spec.md",
  "params": {
    "cart": {
      "type": "endpoint",
      "desc": "Ответ на запрос корзины",
      "all_values": [
        "pending",
        "ok",
        "ok_empty",
        "error_network",
        "error_server"
      ],
      "values": [
        "pending",
        "ok",
        "ok_empty",
        "error"
      ],
      "grouping": "§2 описывает обе ошибки одинаково — заглушка с кнопкой «Повторить»",
      "special": [
        "timeout",
        "malformed"
      ],
      "from": "examples/checkout-spec.md:§2"
    },
    "amount": {
      "type": "number",
      "desc": "Сумма заказа в копейках",
      "all_values": [
        "zero",
        "min_unit",
        "typical",
        "over_max"
      ],
      "values": [
        "zero",
        "min_unit",
        "typical",
        "over_max"
      ],
      "special": [
        "negative"
      ],
      "from": "examples/checkout-spec.md:§3"
    },
    "auth": {
      "type": "enum",
      "desc": "Авторизован ли пользователь",
      "all_values": [
        "guest",
        "user"
      ],
      "values": [
        "guest",
        "user"
      ],
      "from": "examples/checkout-spec.md:§4"
    },
    "promo": {
      "type": "enum",
      "desc": "Состояние промокода",
      "all_values": [
        "absent",
        "valid",
        "expired"
      ],
      "values": [
        "absent",
        "valid",
        "expired"
      ],
      "from": "examples/checkout-spec.md:§4"
    },
    "viewport": {
      "type": "enum",
      "desc": "Брейкпоинт, фиксируется при загрузке",
      "all_values": [
        "mobile",
        "tablet",
        "desktop"
      ],
      "values": [
        "mobile",
        "tablet",
        "desktop"
      ],
      "from": "examples/checkout-spec.md:§1",
      "env": true
    }
  },
  "excluded": {
    "кнопка Повторить": "элемент интерфейса, не вход системы"
  },
  "constraints": [
    {
      "id": "r1",
      "evidence": "examples/checkout-spec.md:§4 — поле промокода доступно только авторизованным",
      "status": "proven",
      "desc": "Гость промокод не применяет",
      "forbid": {
        "auth": "guest",
        "promo": [
          "valid",
          "expired"
        ]
      }
    },
    {
      "id": "r2",
      "evidence": "examples/checkout-spec.md:§2 — до загрузки корзины форма не рендерится",
      "status": "proven",
      "desc": "Пока корзина не пришла, поля формы ни на что не влияют",
      "when": {
        "cart": [
          "pending",
          "error",
          "ok_empty"
        ]
      },
      "irrelevant": [
        "amount",
        "promo",
        "auth"
      ]
    },
    {
      "id": "r3",
      "evidence": "examples/checkout-spec.md:§3 — бесплатный заказ оформляется без выбора оплаты",
      "status": "proven",
      "desc": "У бесплатного заказа промокод бессмыслен",
      "when": {
        "amount": "zero"
      },
      "irrelevant": [
        "promo"
      ]
    }
  ],
  "transitions": [],
  "states": [
    {
      "name": "Загрузка",
      "when": {
        "cart": "pending"
      },
      "desc": "Скелетон формы, кнопка оплаты скрыта",
      "evidence": "examples/checkout-spec.md:§5"
    },
    {
      "name": "Ошибка сети",
      "when": {
        "cart": "error"
      },
      "desc": "Заглушка с кнопкой «Повторить», формы нет",
      "evidence": "examples/checkout-spec.md:§5"
    },
    {
      "name": "Пустая корзина",
      "when": {
        "cart": "ok_empty"
      },
      "desc": "«Корзина пуста» и ссылка в каталог, оформить нельзя",
      "evidence": "examples/checkout-spec.md:§5"
    },
    {
      "name": "Бесплатный заказ",
      "when": {
        "cart": "ok",
        "amount": "zero"
      },
      "desc": "Блок оплаты скрыт, кнопка «Оформить бесплатно»",
      "evidence": "examples/checkout-spec.md:§5"
    },
    {
      "name": "Промокод истёк",
      "when": {
        "cart": "ok",
        "promo": "expired"
      },
      "desc": "Промокод перечёркнут, сумма пересчитана обратно",
      "evidence": "examples/checkout-spec.md:§4"
    },
    {
      "name": "Оформление",
      "when": {
        "cart": "ok"
      },
      "desc": "Форма оплаты, поле промокода видно только авторизованным",
      "evidence": "examples/checkout-spec.md:§5"
    }
  ]
}
