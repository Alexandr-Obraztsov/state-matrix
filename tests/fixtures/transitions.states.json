    {
      "event": "applyPromo",
      "when": {
        "auth": "user",
        "cart": "ok"
      },
      "set": {
        "promo": "valid"
      },
      "evidence": "PromoField.tsx:41"
    },
    {
      "event": "promoExpired",
      "when": {
        "promo": "valid"
      },
      "set": {
        "promo": "expired"
      },
      "evidence": "PromoField.tsx:52 — таймер акции"
    },
    {
      "event": "pickSbp",
      "when": {
        "cart": "ok",
        "hostVersion": "v2"
      },
      "set": {
        "payMethod": "sbp"
      },
