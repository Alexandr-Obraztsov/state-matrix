    {
      "id": "c6",
      "when": {
        "network": "offline"
      },
      "irrelevant": [
        "payMethod",
        "promo",
        "amount"
      ],
      "ask": "в офлайне форма скрывается целиком или остаётся с заблокированной кнопкой?",
      "evidence": "предположение: офлайн блокирует форму, значения полей перестают влиять",
      "status": "assumed"
    }
  ],
  "initial": [
    {
      "cart": "pending",
      "auth": "guest",
      "payMethod": "card",
      "promo": "absent",
      "amount": "typical",
      "network": "online"
    }
  ],
  "transitions": [
    {
      "event": "cartResolved",
      "when": {
        "cart": "pending",
        "network": "online"
      },
      "set": {
        "cart": "ok"
      },
      "evidence": "useCart.ts:31 onSuccess"
    },
    {
      "event": "cartEmpty",
      "when": {
        "cart": "pending",
        "network": "online"
      },
      "set": {
        "cart": "ok_empty",
        "amount": "zero"
      },
      "evidence": "useCart.ts:33 — пустая корзина, сумма ноль"
