        "guest",
        "user"
      ],
      "from": "bootstrap.ts:14 host.token"
    },
    "payMethod": {
      "type": "enum",
      "all_values": [
        "card",
        "sbp",
        "cash"
      ],
      "values": [
        "card",
        "sbp",
        "cash"
      ],
      "special": [
        "unknown_value"
      ],
      "from": "Checkout.tsx:61 methods[]"
    },
    "promo": {
      "type": "enum",
      "all_values": [
        "absent",
        "valid",
        "expired"
      ],
      "values": [
        "absent",
        "valid",
        "expired"
      ],
