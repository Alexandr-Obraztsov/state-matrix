        "order": "нет",
        "retry": "да, идемпотентен"
      }
    },
    "viewport": {
      "type": "enum",
      "all_values": [
        "mobile",
        "tablet",
        "desktop"
      ],
      "values": [
        "mobile",
        "tablet",
        "desktop"
      ],
      "from": "useBreakpoint.ts:12 matchMedia",
