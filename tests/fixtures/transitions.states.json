      "from": "Checkout.tsx:44 useCart()",
      "answers": {
        "codes": "200, 401, 500",
        "empty": "да — пустая корзина это 200 с пустым списком",
        "partial": "да — поля скидки могут прийти null",
        "timeout": "10 секунд",
        "auth": "редирект на логин хоста",
