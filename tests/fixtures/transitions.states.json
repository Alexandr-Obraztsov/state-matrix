    },
    {
      "event": "goOffline",
      "set": {
        "network": "offline"
      },
      "evidence": "window.offline"
    },
    {
      "event": "goOnline",
      "when": {
        "network": "offline"
      },
      "set": {
        "network": "online"
      },
      "evidence": "window.online"
    }
