    },
    {
      "event": "amountNormal",
      "when": {
        "cart": "ok"
      },
      "set": {
        "amount": "typical"
      },
      "evidence": "cart.total"
    },
    {
      "event": "refreshCart",
      "when": {
        "cart": "ok",
        "network": "online"
